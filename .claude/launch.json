{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "map-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec node web/scripts/serve.mjs docs ${PORT:-8765}"],
      "port": 8765
